# lifeline-docking 部署环境变量模板
#
# 用法：复制为 .env 并填入真实值，**不要提交 .env**
#   cp .env.example .env && chmod 600 .env
#
# 真实值见本地留档 D:\hermes\vps\vps-凭据与客户端参数.md 第 7 节，
# 服务器侧落盘于 /data/lifeline/.env（0600）。

# 数据库（复用既有 gqxq-mysql 容器）
LIFELINE_DB_NAME=lifeline_docking
LIFELINE_DB_USER=lifeline
LIFELINE_DB_PASSWORD=请替换为真实口令

# AES-256-GCM 主密钥（Base64，解码后 32 字节）
# 用于加密企业登记的 secretKey。
# 更换或丢失会导致已登记的 secretKey 全部无法解密。
# 生成：openssl rand -base64 32
LIFELINE_MASTER_KEY=请替换为真实主密钥
